      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveglia non impostata. Consenti a Sleepify di usare le sveglie nelle Impostazioni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm not set. Allow Sleepify to use alarms in Settings."
          }
        }
      }
    },
    "alarm_failed": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile impostare la sveglia. Riprova."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not set the alarm. Try again."
          }
        }
      }
    },
