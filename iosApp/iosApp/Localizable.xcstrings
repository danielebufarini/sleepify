      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveglia impostata alle %@, alla prossima occorrenza dell’orario."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm set for %@, at the next occurrence of this time."
