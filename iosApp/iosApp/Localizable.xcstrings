    },
    "alarm_once_note": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sveglie suonano una sola volta, alla prossima occorrenza dell’orario. Modificare il calcolo non cambia le sveglie già impostate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms ring once, at the next occurrence of their time. Changing the calculation does not change alarms already set."
          }
        }
      }
    },
    "cancel_alarm": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla sveglia delle %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel alarm for %@"
          }
        }
      }
