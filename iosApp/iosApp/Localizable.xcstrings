    "estimate_title": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come funziona"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        }
      }
    },
    "estimate_note": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolo indicativo basato su cicli di 90 minuti. Il tempo per addormentarsi viene incluso nell’orario."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates use 90-minute cycles. The time to fall asleep is included in the calculation."
          }
        }
      }
    },
    "disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cicli reali del sonno variano da persona a persona. Questo strumento fornisce stime, non previsioni mediche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual sleep cycles vary from person to person. This tool provides estimates, not medical predictions."
          }
        }
      }
    },
